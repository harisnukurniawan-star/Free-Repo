# Control Room Database OCI
# Keep all values server-side only. Never expose them as NEXT_PUBLIC_* variables.

# demo      = built-in sample metadata
# snapshot  = sanitized OCI metadata supplied through an environment secret
# direct    = direct MySQL connection (only suitable when the runtime can reach the DB network)
CONTROL_ROOM_DB_MODE=demo

# Snapshot mode. Prefer base64 so multiline JSON is not mangled by hosting dashboards.
CONTROL_ROOM_DB_SNAPSHOT_B64=
# Alternative to base64; leave empty when using B64.
CONTROL_ROOM_DB_SNAPSHOT_JSON=

# Direct mode (not recommended for the private HeatWave endpoint from public hosting).
OCI_DB_HOST=
OCI_DB_PORT=3306
OCI_DB_NAME=
OCI_DB_USER=
OCI_DB_PASSWORD=
OCI_DB_SSL=true
