# Control Room Database OCI
# Snapshot mode is the safe default: it uses sanitized metadata captured by the IAM-only OCI monitor.
CONTROL_ROOM_DB_MODE=snapshot

# Direct mode is optional for a server that can privately reach HeatWave.
# Keep these server-side only. Never expose them as NEXT_PUBLIC_* variables.
OCI_DB_HOST=
OCI_DB_PORT=3306
OCI_DB_NAME=railway
OCI_DB_USER=
OCI_DB_PASSWORD=
OCI_DB_SSL=true
