# Control Room Database OCI
# Snapshot mode is the safe default: it uses sanitized metadata captured by the IAM-only OCI monitor.
CONTROL_ROOM_DB_MODE=snapshot

# Direct mode is optional for a server that can privately reach HeatWave.
# Keep these server-side only. Never expose them as NEXT_PUBLIC_* variables.
OCI_DB_HOST=
OCI_DB_PORT=3306
OCI_DB_NAME=railway
OCI_DB_USER=
OCI_DB_PASSWORD=
OCI_DB_SSL=true

# AI ROOM — keep these server-side (never NEXT_PUBLIC_).
AI_ROOM_VIDEO_PROVIDER=development
AI_ROOM_FAL_KEY=
# REQUIRED to permit paid generation. Use a unique random 32+ character value.
# If absent or shorter than 16 characters, POST /api/ai-room/generate is locked.
AI_ROOM_GENERATE_ACCESS_KEY=

# Optional hardened per-user private AI ROOM mode. Leave 'browser' until OCI is ready.
# Only the exact value 'oci' turns this on; never use NEXT_PUBLIC_ for secrets.
AI_ROOM_STORAGE_MODE=browser
AI_ROOM_OCI_NAMESPACE=
AI_ROOM_OCI_BUCKET=ai-room-private-videos
# Set true ONLY after scripts/check-ai-room-oci-bucket.sh prints PASS.
AI_ROOM_OCI_BUCKET_PRIVACY_VERIFIED=false
AI_ROOM_OCI_ACCESS_KEY_ID=
AI_ROOM_OCI_SECRET_ACCESS_KEY=
# OCI region is intentionally fixed to ap-batam-1 in the server adapter.
# Generate a random 32+ byte session secret; NEVER re-use fal or OCI credentials.
AI_ROOM_SESSION_SECRET=
# JSON array of {id,salt,passwordHash}; scrypt N=16384 r=8 p=1, 64-byte hash as hex.
AI_ROOM_USERS_JSON=
# Safe default 5 chargeable requests per user per UTC day (1–30).
AI_ROOM_DAILY_JOB_LIMIT=5
